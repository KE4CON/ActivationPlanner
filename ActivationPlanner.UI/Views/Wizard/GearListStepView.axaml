<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ActivationPlanner.UI.ViewModels.Wizard"
             xmlns:vmroot="clr-namespace:ActivationPlanner.UI.ViewModels"
             xmlns:gear="clr-namespace:ActivationPlanner.PropagationModel.Gear;assembly=ActivationPlanner.PropagationModel"
             mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="450"
             x:Class="ActivationPlanner.UI.Views.Wizard.GearListStepView"
             x:DataType="vm:GearListStepViewModel">
    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Start from a model (shown only for categories that have presets, e.g. Radios) -->
        <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,8" IsVisible="{Binding HasPresets}">
            <TextBlock Text="Start from a model" FontSize="12" Opacity="0.7" />
            <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                      HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vmroot:GearPresetChoice">
                        <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                       Text="Pick your model to fill in the name, or just type it in below. Leave the list on Custom to enter your own." />
        </StackPanel>

        <!-- Add form -->
        <Grid Grid.Row="1" ColumnDefinitions="2*,3*,Auto" ColumnSpacing="8">
            <TextBox Grid.Column="0"
                     PlaceholderText="{Binding NamePlaceholder}"
                     Text="{Binding NewName}" />
            <TextBox Grid.Column="1"
                     PlaceholderText="Notes (optional)"
                     Text="{Binding NewNotes}" />
            <Button Grid.Column="2" Content="Add"
                    Command="{Binding AddCommand}" MinWidth="80" />
        </Grid>

        <!-- Running list -->
        <Border Grid.Row="2" Classes="card" Margin="0,12,0,0">
            <ScrollViewer Padding="0,0,10,0">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="gear:GearItem">
                            <Grid ColumnDefinitions="*,Auto" Margin="12,8">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Notes}"
                                               IsVisible="{Binding Notes, Converter={x:Static ObjectConverters.IsNotNull}}"
                                               Opacity="0.7" FontSize="12" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Remove"
                                        Command="{Binding $parent[UserControl].((vm:GearListStepViewModel)DataContext).RemoveCommand}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
