<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ActivationPlanner.UI.ViewModels"
             xmlns:bands="clr-namespace:ActivationPlanner.PropagationModel.Bands;assembly=ActivationPlanner.PropagationModel"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="680"
             x:Class="ActivationPlanner.UI.Views.BandPlanView"
             x:DataType="vm:BandPlanViewModel">
    <DockPanel Margin="20">
        <!-- Header -->
        <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,10">
            <TextBlock Text="Band plan" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Opacity="0.7" FontSize="12" TextWrapping="Wrap" MaxWidth="760"
                       Text="US amateur privileges at a glance — where each license class may operate and in what modes, based on the FCC Part 97 allocations. A quick reference, not a legal authority; always follow the current FCC rules." />
        </StackPanel>

        <!-- Power/legality note pinned at the bottom -->
        <TextBlock DockPanel.Dock="Bottom" FontSize="11" Opacity="0.6" TextWrapping="Wrap" Margin="0,10,0,0"
                   Text="Power: up to 1500 W PEP unless a segment notes a lower limit — but always use the minimum needed (FCC §97.313). This is a plain-language summary of US privileges; the current FCC Part 97 rules are the authority." />

        <ScrollViewer Padding="0,0,10,0">
            <ItemsControl ItemsSource="{Binding Bands}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="bands:BandPlanBand">
                        <Border Classes="card" Padding="14" Margin="0,2,2,12">
                            <StackPanel Spacing="8">
                                <!-- Band header -->
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" FontSize="18"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Range}" Opacity="0.7" Margin="10,0,0,0"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource AccentText}" />

                                <!-- Segment table -->
                                <Border Classes="inset" Padding="10,8">
                                    <StackPanel Spacing="4">
                                        <Grid ColumnDefinitions="150,*,150">
                                            <TextBlock Grid.Column="0" Text="Frequency" FontSize="11" Opacity="0.6" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="Modes" FontSize="11" Opacity="0.6" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="2" Text="License" FontSize="11" Opacity="0.6" FontWeight="SemiBold" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Segments}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="bands:BandPlanSegment">
                                                    <Grid ColumnDefinitions="150,*,150" Margin="0,3,0,0">
                                                        <TextBlock Grid.Column="0" Text="{Binding Range}" FontSize="12"
                                                                   FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Modes}" FontSize="12"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Licenses}" FontSize="12"
                                                                   Opacity="0.85" TextWrapping="Wrap" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
