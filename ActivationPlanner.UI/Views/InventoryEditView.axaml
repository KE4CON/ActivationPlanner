<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ActivationPlanner.UI.ViewModels"
             xmlns:gear="clr-namespace:ActivationPlanner.PropagationModel.Gear;assembly=ActivationPlanner.PropagationModel"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="650"
             x:Class="ActivationPlanner.UI.Views.InventoryEditView"
             x:DataType="vm:InventoryEditViewModel">
    <DockPanel Margin="24">
        <TextBlock DockPanel.Dock="Top" Text="Gear Inventory"
                   FontSize="24" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock DockPanel.Dock="Top" Opacity="0.7" Margin="0,0,0,16"
                   Text="Add, edit, or remove gear at any time. Changes are saved automatically." />

        <TabControl>
            <!-- ============ Gear tab ============ -->
            <TabItem Header="Gear">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20" Margin="0,12,0,0">
                    <!-- Form -->
                    <Border Grid.Column="0" Width="300" Padding="16" VerticalAlignment="Top"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="1" CornerRadius="6">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Add / edit gear" FontWeight="SemiBold" />
                            <StackPanel Spacing="2">
                                <TextBlock Text="Category" FontSize="12" Opacity="0.7" />
                                <ComboBox ItemsSource="{Binding GearCategories}"
                                          SelectedItem="{Binding GearCategory}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Name" FontSize="12" Opacity="0.7" />
                                <TextBox Text="{Binding GearName}" PlaceholderText="e.g. IC-705" />
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Notes" FontSize="12" Opacity="0.7" />
                                <TextBox Text="{Binding GearNotes}" PlaceholderText="optional" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,Auto">
                                <Button Grid.Column="0" Content="{Binding GearButtonText}"
                                        Command="{Binding SaveGearCommand}"
                                        Classes="accent" HorizontalAlignment="Stretch" />
                                <Button Grid.Column="1" Content="Clear"
                                        Command="{Binding ClearGearFormCommand}" Margin="8,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- List -->
                    <Border Grid.Column="1"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="1" CornerRadius="6">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Gear}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="gear:GearItem">
                                        <Border Padding="12,8"
                                                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                                BorderThickness="0,0,0,1">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock Opacity="0.7" FontSize="12"
                                                               Text="{Binding Category, StringFormat='{}{0}'}" />
                                                    <TextBlock Opacity="0.7" FontSize="12"
                                                               Text="{Binding Notes}"
                                                               IsVisible="{Binding Notes, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Edit"
                                                        Command="{Binding $parent[UserControl].((vm:InventoryEditViewModel)DataContext).EditGearCommand}"
                                                        CommandParameter="{Binding}" />
                                                <Button Grid.Column="2" Content="Remove"
                                                        Command="{Binding $parent[UserControl].((vm:InventoryEditViewModel)DataContext).RemoveGearCommand}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============ Antennas tab ============ -->
            <TabItem Header="Antennas">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20" Margin="0,12,0,0">
                    <!-- Form -->
                    <Border Grid.Column="0" Width="320" Padding="16" VerticalAlignment="Top"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="1" CornerRadius="6">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Add / edit antenna" FontWeight="SemiBold" />
                            <StackPanel Spacing="2">
                                <TextBlock Text="Name" FontSize="12" Opacity="0.7" />
                                <TextBox Text="{Binding AntennaName}" PlaceholderText="e.g. 40m EFHW" />
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Category" FontSize="12" Opacity="0.7" />
                                <ComboBox ItemsSource="{Binding AntennaCategories}"
                                          SelectedItem="{Binding AntennaCategory}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Feed point" FontSize="12" Opacity="0.7" />
                                <ComboBox ItemsSource="{Binding FeedPoints}"
                                          SelectedItem="{Binding FeedPoint}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="{Binding LengthLabel}" FontSize="12" Opacity="0.7" />
                                    <TextBox Text="{Binding LengthFeet}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Height (ft)" FontSize="12" Opacity="0.7" />
                                    <TextBox Text="{Binding HeightFeet}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding LengthHint}" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding HeightHint}" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                            <StackPanel Spacing="2" IsVisible="{Binding ShowRadials}">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="Radial count" FontSize="12" Opacity="0.7" />
                                        <TextBox Text="{Binding RadialCount}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="Radial len (ft)" FontSize="12" Opacity="0.7" />
                                        <TextBox Text="{Binding RadialLengthFeet}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding RadialHint}" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,Auto">
                                <Button Grid.Column="0" Content="{Binding AntennaButtonText}"
                                        Command="{Binding SaveAntennaCommand}"
                                        Classes="accent" HorizontalAlignment="Stretch" />
                                <Button Grid.Column="1" Content="Clear"
                                        Command="{Binding ClearAntennaFormCommand}" Margin="8,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- List -->
                    <Border Grid.Column="1"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="1" CornerRadius="6">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Antennas}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="gear:AntennaProfile">
                                        <Border Padding="12,8"
                                                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                                BorderThickness="0,0,0,1">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock Opacity="0.7" FontSize="12"
                                                               Text="{Binding Category, StringFormat='{}{0}'}" />
                                                    <TextBlock Opacity="0.7" FontSize="12">
                                                        <Run Text="{Binding LengthFeet, Mode=OneWay}" /><Run Text=" ft long, " /><Run Text="{Binding HeightFeet, Mode=OneWay}" /><Run Text=" ft high" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Edit"
                                                        Command="{Binding $parent[UserControl].((vm:InventoryEditViewModel)DataContext).EditAntennaCommand}"
                                                        CommandParameter="{Binding}" />
                                                <Button Grid.Column="2" Content="Remove"
                                                        Command="{Binding $parent[UserControl].((vm:InventoryEditViewModel)DataContext).RemoveAntennaCommand}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
