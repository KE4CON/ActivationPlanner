<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ActivationPlanner.UI.ViewModels"
             xmlns:weather="clr-namespace:ActivationPlanner.Services.Weather;assembly=ActivationPlanner.Services"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="680"
             x:Class="ActivationPlanner.UI.Views.WeatherView"
             x:DataType="vm:WeatherViewModel">
    <DockPanel Margin="20">
        <!-- Header -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="Weather" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{Binding LocationLabel}" FontSize="12" Opacity="0.7"
                           IsVisible="{Binding LocationLabel, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Opacity="0.7" FontSize="12" TextWrapping="Wrap"
                           Text="Forecast for your current location, so you can plan around wind, rain, and temperature. US locations (National Weather Service). Watches/warnings pop up on any screen." />
            </StackPanel>
            <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" VerticalAlignment="Center" />
        </Grid>

        <TextBlock DockPanel.Dock="Top" Text="Loading forecast…" IsVisible="{Binding IsBusy}"
                   Opacity="0.7" Margin="0,0,0,8" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMessage}" TextWrapping="Wrap" Opacity="0.8"
                   Margin="0,0,0,8"
                   IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <ScrollViewer IsVisible="{Binding HasPeriods}" Padding="0,0,10,0">
            <ItemsControl ItemsSource="{Binding Periods}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="weather:WeatherPeriod">
                        <Border Classes="card" Padding="14" Margin="0,2,2,10">
                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" FontSize="15"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding TemperatureText}" FontWeight="Bold"
                                               FontSize="18" Foreground="{DynamicResource AccentText}" />
                                </Grid>
                                <TextBlock Text="{Binding ShortForecast}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding WindText, StringFormat='Wind: {0}'}" FontSize="12" Opacity="0.7"
                                           IsVisible="{Binding WindText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <TextBlock Text="{Binding DetailedForecast}" FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
