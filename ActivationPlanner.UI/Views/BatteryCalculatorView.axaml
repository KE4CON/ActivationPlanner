<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ActivationPlanner.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="680"
             x:Class="ActivationPlanner.UI.Views.BatteryCalculatorView"
             x:DataType="vm:BatteryCalculatorViewModel">
    <Grid ColumnDefinitions="360,*" Margin="20">
        <!-- Inputs -->
        <Border Grid.Column="0" Classes="card" Padding="16" Margin="0,0,16,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
                <StackPanel Spacing="10">
                    <TextBlock Text="Battery runtime" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Opacity="0.7" TextWrapping="Wrap"
                               Text="Estimate how long a battery will run your radio in the field. Pick your gear to prefill, then tune the numbers." />

                    <!-- Battery -->
                    <StackPanel Spacing="2">
                        <TextBlock Text="Battery (prefill from your gear)" FontSize="12" Opacity="0.7" />
                        <ComboBox ItemsSource="{Binding Batteries}" SelectedItem="{Binding SelectedBattery}"
                                  HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="Capacity (Ah)" FontSize="12" Opacity="0.7" />
                            <TextBox Text="{Binding CapacityAh}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Usable %" FontSize="12" Opacity="0.7" />
                            <TextBox Text="{Binding UsablePercent}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                               Text="Usable %: how much of the battery you'll actually draw. LiFePO4/lithium ~90%; lead-acid/AGM ~50% (don't run it flat)." />

                    <!-- Radio -->
                    <StackPanel Spacing="2">
                        <TextBlock Text="Radio (prefill from your gear)" FontSize="12" Opacity="0.7" />
                        <ComboBox ItemsSource="{Binding Radios}" SelectedItem="{Binding SelectedRadio}"
                                  HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="TX power (W)" FontSize="12" Opacity="0.7" />
                            <TextBox Text="{Binding TxPowerWatts}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Supply (V)" FontSize="12" Opacity="0.7" />
                            <TextBox Text="{Binding SupplyVoltage}" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="TX efficiency %" FontSize="12" Opacity="0.7" />
                            <TextBox Text="{Binding TxEfficiencyPercent}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="RX current (A)" FontSize="12" Opacity="0.7" />
                            <TextBox Text="{Binding RxCurrentAmps}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                               Text="Efficiency is DC-in to RF-out (~55% is typical for an HF final). RX current is the idle/receive draw — ~1 A for a 100 W radio, less for QRP." />

                    <!-- Duty cycle -->
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding TxDutyPercent, StringFormat='Transmit duty: {0:0}%'}" FontWeight="SemiBold" />
                        <Slider Minimum="0" Maximum="100" Value="{Binding TxDutyPercent}"
                                TickFrequency="5" IsSnapToTickEnabled="True" />
                        <TextBlock FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                                   Text="How much of the time you're actually transmitting. Casual POTA/SOTA ~15–25%, SSB ragchewing ~25%, contesting/digital higher." />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Result -->
        <Border Grid.Column="1" Classes="card" Padding="24" VerticalAlignment="Top">
            <StackPanel Spacing="12">
                <TextBlock Text="Estimated runtime" FontSize="14" Opacity="0.7" />
                <TextBlock Text="{Binding RuntimeText}" FontSize="40" FontWeight="Bold"
                           Foreground="{DynamicResource AccentText}" />
                <TextBlock Text="{Binding RuntimeVerdict}" TextWrapping="Wrap" FontSize="14" />
                <Border Classes="inset" Padding="14" Margin="0,4,0,0">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding TxCurrentText}" />
                        <TextBlock Text="{Binding AvgCurrentText}" />
                    </StackPanel>
                </Border>
                <TextBlock FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                           Text="A rough estimate — real draw varies by radio, mode, and conditions. Leave yourself a margin, and a spare battery for long or cold outings." />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
