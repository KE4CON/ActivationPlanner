<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ActivationPlanner.UI.ViewModels"
        xmlns:conv="clr-namespace:ActivationPlanner.UI.Converters"
        mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="680"
        x:Class="ActivationPlanner.UI.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="960" Height="680"
        MinWidth="760" MinHeight="540"
        Title="Activation Planner">
    <Window.Resources>
        <conv:NavActiveConverter x:Key="NavActive" />
    </Window.Resources>
    <DockPanel Background="{DynamicResource AppCanvas}">
        <!-- Top navigation (hidden during the first-run wizard) -->
        <Border DockPanel.Dock="Top" IsVisible="{Binding ShowNavigation}"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource AccentText}" BorderThickness="0,0,0,2"
                Padding="16,8">
            <Grid ColumnDefinitions="*,Auto">
                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Quick plan" Command="{Binding ShowQuickPlanCommand}" Classes="nav" Margin="0,2,4,2"
                            Classes.active="{Binding ActivePage, Converter={StaticResource NavActive}, ConverterParameter=QuickPlan}" />
                    <Button Content="Plan session" Command="{Binding ShowPlanningCommand}" Classes="nav" Margin="0,2,4,2"
                            Classes.active="{Binding ActivePage, Converter={StaticResource NavActive}, ConverterParameter=Planning}" />
                    <Button Content="Trend" Command="{Binding ShowTrendCommand}" Classes="nav" Margin="0,2,4,2"
                            Classes.active="{Binding ActivePage, Converter={StaticResource NavActive}, ConverterParameter=Trend}" />
                    <Button Content="Grey line" Command="{Binding ShowGreyLineCommand}" Classes="nav" Margin="0,2,4,2"
                            Classes.active="{Binding ActivePage, Converter={StaticResource NavActive}, ConverterParameter=GreyLine}" />
                    <Button Content="Mission &amp; checklist" Command="{Binding ShowMissionChecklistCommand}" Classes="nav" Margin="0,2,4,2"
                            Classes.active="{Binding ActivePage, Converter={StaticResource NavActive}, ConverterParameter=Mission}" />
                    <Button Content="POTA spots" Command="{Binding ShowPotaSpotsCommand}" Classes="nav" Margin="0,2,4,2"
                            Classes.active="{Binding ActivePage, Converter={StaticResource NavActive}, ConverterParameter=Pota}" />
                    <Button Content="Antenna" Command="{Binding ShowAntennaPatternCommand}" Classes="nav" Margin="0,2,4,2"
                            Classes.active="{Binding ActivePage, Converter={StaticResource NavActive}, ConverterParameter=Antenna}" />
                    <Button Content="Inventory" Command="{Binding ShowInventoryCommand}" Classes="nav" Margin="0,2,4,2"
                            Classes.active="{Binding ActivePage, Converter={StaticResource NavActive}, ConverterParameter=Inventory}" />
                    <Button Content="Battery" Command="{Binding ShowBatteryCalculatorCommand}" Classes="nav" Margin="0,2,4,2"
                            Classes.active="{Binding ActivePage, Converter={StaticResource NavActive}, ConverterParameter=Battery}" />
                </WrapPanel>

                <!-- Persistent clock: local above UTC, in an elevated pill so it stands out -->
                <Border Grid.Column="1" Classes="card" Padding="12,6" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="1">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="LOCAL" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LocalTimeText}"
                                   FontSize="16" FontWeight="SemiBold" TextAlignment="Right" MinWidth="72" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="UTC" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" Opacity="0.85" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UtcTimeText}"
                                   FontSize="16" FontWeight="SemiBold" TextAlignment="Right" MinWidth="72" Opacity="0.85" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <ContentControl Content="{Binding CurrentPage}" />
    </DockPanel>
</Window>
