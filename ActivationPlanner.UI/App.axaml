<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ActivationPlanner.UI"
             x:Class="ActivationPlanner.UI.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- Light: white cards float on a soft gray canvas, with a clear shadow. -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppCanvas" Color="#E4EBF6" />
                    <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CardBorder" Color="#10000000" />
                    <SolidColorBrush x:Key="InsetBackground" Color="#EDF0F5" />
                    <BoxShadows x:Key="CardShadow">0 4 16 0 #29000000</BoxShadows>
                    <SolidColorBrush x:Key="AccentText" Color="#2F6FEB" />
                    <SolidColorBrush x:Key="AccentSoft" Color="#142F6FEB" />
                    <SolidColorBrush x:Key="RowSeparator" Color="#DCE0E7" />
                </ResourceDictionary>
                <!-- Dark: lighter cards float on a near-black canvas, with a deeper shadow. -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppCanvas" Color="#12151E" />
                    <SolidColorBrush x:Key="CardBackground" Color="#2A2E3A" />
                    <SolidColorBrush x:Key="CardBorder" Color="#24FFFFFF" />
                    <SolidColorBrush x:Key="InsetBackground" Color="#34343D" />
                    <BoxShadows x:Key="CardShadow">0 4 18 0 #70000000</BoxShadows>
                    <SolidColorBrush x:Key="AccentText" Color="#5B93FF" />
                    <SolidColorBrush x:Key="AccentSoft" Color="#242F6FEB" />
                    <SolidColorBrush x:Key="RowSeparator" Color="#3B3C46" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://ActivationPlanner.UI/Styles/AppStyles.axaml" />
    </Application.Styles>
</Application>
