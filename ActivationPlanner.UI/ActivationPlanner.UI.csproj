<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- SPIKE (spike/sharpengine-avalonia12): 3D far-field view. Commercial lib, free for
         non-commercial OSS. Validate Avalonia-12 compat + Vulkan render before keeping. -->
    <PackageReference Include="Ab4d.SharpEngine" Version="4.1.9689" />
    <PackageReference Include="Ab4d.SharpEngine.AvaloniaUI" Version="4.1.9689" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled map data + other UI assets (Natural Earth 110m land, public domain). -->
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ActivationPlanner.Services\ActivationPlanner.Services.csproj" />
    <ProjectReference Include="..\ActivationPlanner.PropagationModel\ActivationPlanner.PropagationModel.csproj" />
  </ItemGroup>
</Project>
