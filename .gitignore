# OS junk files
.DS_Store
Thumbs.db
desktop.ini

# Word/Office lock files (created when a .docx is open)
~$*

# .NET build output
bin/
obj/
*.user
*.suo

# Installer / packaging outputs (build/package.*, build/build-engines.*)
dist/
build/.engine-build/

# Bundled engine binaries — built by build/build-engines.*, never committed.
# Keep the staging-area README; ignore the per-RID binary folders.
third_party/*/
!third_party/README.md

# NEC2++ GPLv2 COPYING + source snapshot are copied in during the engine build.
licenses/nec2++/

# Visual Studio
.vs/

# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Rider / JetBrains
.idea/
*.sln.iml

# Test results
TestResults/
*.trx

# NuGet
*.nupkg
**/packages/*
!**/packages/build/

# Publish output
publish/
*.pubxml.user

# Local settings / secrets (never commit real credentials)
appsettings.local.json
secrets.json
